---
import Layout from '../layouts/Layout.astro';import ProjectList from '../components/ProjectList.astro';import {profile} from '../data/profile';import {getCollection} from 'astro:content';import {published,newest,sitePath} from '../lib/content.mjs';
const projects=published(await getCollection('work')).filter(p=>p.data.featured).slice(0,3);const posts=newest(published(await getCollection('thoughts'))).slice(0,3);const href=(p:string)=>sitePath(p,import.meta.env.BASE_URL);
---
<Layout title="Analytics, data science & engineering"><section class="hero"><div><p class="eyebrow"><span class="dot"></span>Analytics · Data science · Engineering</p><h1>From analysis<br/>to models to<br/><em>data systems.</em></h1><p class="intro">{profile.intro}</p><div class="actions"><a class="button" href={href('/work/')}>Explore my work ↘</a><a href={href('/about/')}>The story so far</a></div></div><aside class="diagram" aria-label="Three connected disciplines"><p class="eyebrow">A connected approach</p><h2>Ask better questions.</h2><div class="connector"></div><div class="pills"><span>Analyze</span><span>Experiment</span><span>Build</span></div><div class="connector"></div><h2>Make data useful.</h2><p>From the business question<br/>to the technical foundation.</p></aside></section><section class="section"><div class="section-head"><h2><span>01 /</span> Selected work</h2><a href={href('/work/')}>All projects ↗</a></div><ProjectList projects={projects}/></section><section class="section"><div class="section-head"><h2><span>02 /</span> Across the data stack</h2></div><div class="disciplines">{profile.disciplines.map(d=><article><h3>{d.title}</h3><p>{d.description}</p><small>{d.tools}</small></article>)}</div></section><section class="section career-teaser"><div><p class="eyebrow">The story so far</p><h2>Data work in<br/><em>real-world products.</em></h2></div><div><p>Experience across online travel at Booking.com and mobility at DiDi, with a background in business analytics.</p><a href={href('/about/')}>Career, education & capabilities ↗</a></div></section>{posts.length>0&&<section class="section"><div class="section-head"><h2>Recent thoughts</h2><a href={href('/thoughts/')}>All writing ↗</a></div>{posts.map(post=><article class="post-row"><h3><a href={href(`/thoughts/${post.id}/`)}>{post.data.title}</a></h3><p>{post.data.summary}</p></article>)}</section>}<section class="contact"><div><h2>Continue the conversation.</h2><p>For a role, a project, or a shared interest in data.</p></div><a href={profile.linkedin}>Connect on LinkedIn ↗</a></section></Layout>
