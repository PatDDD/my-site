---
import Layout from '../../layouts/Layout.astro';import {getCollection} from 'astro:content';import {published,newest,sitePath} from '../../lib/content.mjs';const posts=newest(published(await getCollection('thoughts')));
---
<Layout title="Thoughts" description="Notes on analytics, data science, engineering, and the practice of working with data."><section class="page-heading"><p class="eyebrow">An open notebook</p><h1>Thoughts,<br/><em>in progress.</em></h1><p class="intro">A place for notes on analytical methods, data systems, and questions worth exploring.</p></section>{posts.length?posts.map(post=><article class="post-row"><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10)}</time><h2><a href={sitePath(`/thoughts/${post.id}/`,import.meta.env.BASE_URL)}>{post.data.title}</a></h2><p>{post.data.summary}</p></article>):<section class="empty"><span aria-hidden="true">↳</span><div><h2>The first page is still unwritten.</h2><p>No articles are published yet. This space will grow with actual writing.</p></div></section>}</Layout>
